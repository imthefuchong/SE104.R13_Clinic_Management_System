<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="570.0" spacing="10.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 18;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.MedicineSelectionDialogController">

    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
           text="💊 Thêm thuốc vào đơn thuốc" />

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Tìm thuốc:" />
        <TextField fx:id="tfSearch" promptText="Nhập tên thuốc hoặc mã thuốc..."
                   HBox.hgrow="ALWAYS" />
        <Button onAction="#handleSearch"
                styleClass="btn-secondary" text="⌕ Tìm" />
    </HBox>

    <TableView fx:id="tableMedicine" prefHeight="100.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTenThuoc" prefWidth="200.0" text="Tên thuốc" />
            <TableColumn fx:id="colDonVi" prefWidth="105.0" text="Đơn vị tính" />
            <TableColumn fx:id="colGiaTien" prefWidth="100.0" text="Đơn giá" />
            <TableColumn fx:id="colSoLuong" prefWidth="105.0" text="Số lượng tồn" />
        </columns>
        <placeholder>
            <Label text="Không có thuốc đang sử dụng" />
        </placeholder>
    </TableView>

    <TitledPane animated="false" expanded="true" text="Thông tin thuốc được chọn">
        <GridPane hgap="10.0" vgap="8.0">
            <padding>
                <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
            </padding>
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="95.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Tên thuốc:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="tfSelectedTenThuoc" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Đơn vị tính:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="tfSelectedDonVi" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Đơn giá:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="tfSelectedGiaTien" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Số lượng tồn:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="tfSelectedSoLuongKho" editable="false"
                       GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label style="-fx-font-weight: bold;" text="Số lượng:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Spinner fx:id="spSelectedSoLuong" editable="true" prefWidth="150.0"
                     GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Cách dùng:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <ComboBox fx:id="cbSelectedHuongDan" editable="true" maxWidth="Infinity"
                      GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label fx:id="lblValidation" text="Số lượng phải lớn hơn 0 và không vượt quá số lượng tồn"
                   style="-fx-text-fill: #E53E3E; -fx-font-size: 11px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </GridPane>
    </TitledPane>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <padding><Insets top="2.0" /></padding>
        <Button onAction="#handleAddToBill"
                styleClass="btn-primary" text="＋ Thêm vào đơn" />
        <Button cancelButton="true" onAction="#handleCancel"
                styleClass="btn-secondary" text="✖ Hủy" />
    </HBox>
</VBox>
