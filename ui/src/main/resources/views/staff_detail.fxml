<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="420.0" prefWidth="760.0" spacing="20.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 32;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.StaffDetailController">

    <!-- Form 2 cột chuẩn 100% Mockup Trang 17 PDF -->
    <GridPane hgap="32.0" vgap="18.0">
        <columnConstraints>
            <!-- Cột trái: Nhãn & Ô nhập -->
            <ColumnConstraints halignment="RIGHT" minWidth="95.0" prefWidth="105.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            <!-- Cột phải: Nhãn & Ô nhập -->
            <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <!-- Hàng 0: Mã nhân viên | Chức vụ -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Mã nhân viên" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="tfId" editable="false" prefHeight="38.0" promptText="NV001"
                   style="-fx-background-color: #F1F5F9; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Chức vụ" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbRole" maxWidth="Infinity" prefHeight="38.0" promptText="Bác sĩ"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                  GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- Hàng 1: Họ và tên | Giới tính -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Họ và tên" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="tfFullName" prefHeight="38.0" promptText="Nguyễn Văn A"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Giới tính" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <HBox spacing="14.0" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="1">
            <ToggleButton fx:id="btnMale" prefHeight="38.0" prefWidth="85.0"
                          style="-fx-background-color: #00B0FF; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                          text="Nam" />
            <ToggleButton fx:id="btnFemale" prefHeight="38.0" prefWidth="85.0"
                          style="-fx-background-color: #FFFFFF; -fx-border-color: #F48FB1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-text-fill: #1E293B; -fx-font-weight: bold; -fx-cursor: hand;"
                          text="Nữ" />
        </HBox>

        <!-- Hàng 2: Ngày sinh | Số điện thoại -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Ngày sinh" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="dpBirth" maxWidth="Infinity" prefHeight="38.0" promptText="15/05/1990"
                    style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Số điện thoại" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="tfPhone" prefHeight="38.0" promptText="0901234567"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                   GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <!-- Hàng 3: Email | Trạng thái -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Email" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="tfEmail" prefHeight="38.0" promptText="admin@phongmach.com"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Trạng thái" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <ComboBox fx:id="cbStatus" maxWidth="Infinity" prefHeight="38.0" promptText="Đang làm việc"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                  GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <!-- Hàng 4: Địa chỉ | Nút bấm thao tác -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #1E293B;" text="Địa chỉ" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="tfAddress" prefHeight="38.0" promptText="123 Nguyễn Trãi, Q1, TP.HCM"
                   style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13.5px;"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Cặp nút Cập nhật (Tím) & Xóa (Đỏ cam) / Thêm mới (Xanh lá) chuẩn PDF -->
        <HBox spacing="14.0" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="4">
            <!-- Nút Thêm mới (khi tạo mới) -->
            <Button fx:id="btnRegister" onAction="#register" prefHeight="38.0" prefWidth="110.0"
                    style="-fx-background-color: #48BB78; -fx-text-fill: white; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Lưu" />

            <!-- Nút Cập nhật (khi sửa) màu Tím tím chuẩn Mockup -->
            <Button fx:id="btnUpdate" onAction="#update" prefHeight="38.0" prefWidth="110.0"
                    style="-fx-background-color: #7E57C2; -fx-text-fill: white; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Cập nhật" />

            <!-- Nút Xóa màu Đỏ cam chuẩn Mockup -->
            <Button fx:id="btnDelete" onAction="#delete" prefHeight="38.0" prefWidth="95.0"
                    style="-fx-background-color: #FF5252; -fx-text-fill: white; -fx-font-size: 13.5px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="Xóa" />
        </HBox>
    </GridPane>

</VBox>
