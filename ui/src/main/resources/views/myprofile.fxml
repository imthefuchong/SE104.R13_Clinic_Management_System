<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" pannable="true"
            style="-fx-background: #FFFFFF; -fx-background-color: #FFFFFF;"
            stylesheets="@../CSS/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.controllers.MyProfileController">

    <VBox style="-fx-background-color: #FFFFFF;" spacing="0">
        <VBox alignment="TOP_CENTER" style="-fx-padding: 0 24 12 24;">
            <Label text="Thông tin cá nhân"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-padding: 12 0 8 0;" />
            <Separator prefWidth="240" style="-fx-background-color: #7BBF9A;" />
        </VBox>

        <VBox style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 16 24 18 24;" spacing="12">
            <Label text="Thông tin cá nhân"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />

            <GridPane hgap="28" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                    <ColumnConstraints halignment="RIGHT" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                </columnConstraints>

                <Label text="Mã nhân viên" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="tfId" editable="false" prefHeight="36"
                           style="-fx-background-color: #F8FAFC;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Tên đăng nhập" style="-fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="tfUsername" editable="false" prefHeight="36"
                           style="-fx-background-color: #F8FAFC;"
                           GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Họ tên" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="tfFullName" prefHeight="36"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Giới tính" style="-fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <HBox spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="1">
                    <ToggleButton fx:id="btnMale" prefHeight="36" prefWidth="80" selected="true"
                                  style="-fx-background-color: #DCEBFF; -fx-text-fill: #1D4ED8;"
                                  text="Nam" />
                    <ToggleButton fx:id="btnFemale" prefHeight="36" prefWidth="80"
                                  style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E1;"
                                  text="Nữ" />
                </HBox>

                <Label text="Chức vụ" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cbRole" maxWidth="Infinity" prefHeight="36"
                          GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Số điện thoại" style="-fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="tfPhone" prefHeight="36"
                           GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Ngày sinh" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <DatePicker fx:id="dpBirth" maxWidth="Infinity" prefHeight="36"
                            GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>
        </VBox>

        <VBox style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 14 24 16 24;" spacing="10">
            <Label text="Thông tin liên hệ"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <GridPane hgap="28" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                    <ColumnConstraints halignment="RIGHT" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                </columnConstraints>

                <Label text="Email" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="tfEmail" prefHeight="36"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Button onAction="#openChangePasswordDialog" prefHeight="34"
                        style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-background-radius: 6;"
                        text="🔒 Đổi mật khẩu"
                        GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Địa chỉ" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="tfAddress" prefHeight="36"
                           GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <VBox style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 14 24 18 24;" spacing="10">
            <Label text="Thông tin công việc"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
            <GridPane hgap="28" vgap="12">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                    <ColumnConstraints prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="40" />
                </columnConstraints>

                <Label text="Mức lương" style="-fx-font-size: 12px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="tfSalary" editable="false" prefHeight="36"
                           style="-fx-border-color: #22C55E; -fx-background-color: #F8FAFC;"
                           GridPane.columnIndex="1" GridPane.rowIndex="0" />
            </GridPane>
        </VBox>

        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 24 14 24;">
            <Button onAction="#handleSaveChanges" prefHeight="38" prefWidth="118"
                    style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-background-radius: 5;"
                    text="Lưu thay đổi" />
        </HBox>

        <StackPane fx:id="passwordContainer" managed="false" visible="false">
            <PasswordField fx:id="tfPassword" />
            <TextField fx:id="tfPasswordVisible" />
            <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility" />
        </StackPane>
        <HBox fx:id="confirmPasswordContainer" managed="false" visible="false">
            <PasswordField fx:id="tfConfirmPassword" />
        </HBox>

        <!-- Existing split-name fields are kept for controller compatibility. -->
        <TextField fx:id="tfLastName" managed="false" visible="false" />
        <TextField fx:id="tfName" managed="false" visible="false" />
        <TextField fx:id="tfCCCD" managed="false" visible="false" />
    </VBox>
</ScrollPane>
