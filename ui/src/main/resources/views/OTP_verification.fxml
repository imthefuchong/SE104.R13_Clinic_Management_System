<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="260.0" prefWidth="380.0" spacing="16.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 30;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.OTPVerificationController">

    <!-- Header Tiêu đề chuẩn PDF -->
    <VBox alignment="CENTER" spacing="4.0">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
               text="Xác minh OTP" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;"
               text="Nhập mã OTP đã gửi qua email:" />
    </VBox>

    <!-- Ô nhập mã OTP -->
    <VBox alignment="CENTER" spacing="6.0">
        <TextField fx:id="otpField" promptText="Nhập 6 chữ số mã OTP"
                   prefHeight="38.0" prefWidth="240.0"
                   style="-fx-alignment: CENTER; -fx-font-size: 15px; -fx-font-weight: bold; -fx-letter-spacing: 2px;" />
    </VBox>

    <!-- Nút Xác nhận xanh lá chuẩn PDF -->
    <VBox alignment="CENTER">
        <padding><Insets top="6.0" /></padding>
        <Button onAction="#handleVerifyOTP"
                prefHeight="36.0" prefWidth="140.0"
                styleClass="btn-primary"
                text="Xác nhận" />
    </VBox>

</VBox>
