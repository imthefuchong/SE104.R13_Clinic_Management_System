<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="420.0" prefWidth="760.0" spacing="18.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 24;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.controllers.MedicineDetailController">

    <!-- Tiêu đề form thuốc chuẩn PDF -->
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
           text="Chi tiết thuốc" />

    <!-- Form nhập thông tin thuốc 2 cột -->
    <GridPane hgap="16.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints halignment="RIGHT" minWidth="100.0" prefWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Hàng 0: Mã thuốc & Tên thuốc -->
        <Label text="Mã thuốc:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="tfId" editable="false" style="-fx-background-color: #F8FAFC;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Tên thuốc:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="tfName" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- Hàng 1: Công dụng & Đơn vị tính -->
        <Label text="Công dụng:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextArea fx:id="tfUse" prefRowCount="2" wrapText="true"
                  GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Đơn vị tính:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <ComboBox fx:id="cbUnit" prefWidth="220.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <!-- Hàng 2: Số lượng tồn & Đơn giá -->
        <Label text="Số lượng tồn:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="tfQuantity" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Đơn giá:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="tfCost" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <ComboBox fx:id="cbStatus" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Hàng 4: Hướng dẫn sử dụng -->
        <Label text="Cách dùng:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="tfGuide" promptText="Nhập hướng dẫn sử dụng" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
    </GridPane>

    <!-- Ghi chú giải thích -->
    <Label style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-font-style: italic;"
           text="ℹ Giá mới không thay đổi giá của các đơn thuốc đã lập trước đó." />

    <!-- Nút Thêm, Cập nhật, Xóa -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding><Insets top="8.0" /></padding>
        <Button fx:id="btnAdd" onAction="#add" styleClass="btn-primary" text="Thêm mới" />
        <Button fx:id="btnUpdate" onAction="#update" styleClass="btn-blue" text="Cập nhật" />
        <Button fx:id="btnDelete" onAction="#delete" styleClass="btn-danger" text="Xóa" />
        <Button fx:id="btnClose" onAction="#closeDialog" styleClass="btn-secondary" text="Đóng" />
    </HBox>

</VBox>
