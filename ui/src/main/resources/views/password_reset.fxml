<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="360.0" prefWidth="400.0" spacing="16.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 30;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.PasswordResetController">

    <!-- Header Tiêu đề chuẩn PDF -->
    <VBox alignment="CENTER" spacing="4.0">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
               text="Đặt lại mật khẩu" />
    </VBox>

    <!-- Mật khẩu mới -->
    <VBox spacing="6.0" alignment="TOP_LEFT">
        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"
               text="Mật khẩu mới" />
        <StackPane>
            <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu mới" prefHeight="36.0" />
            <TextField fx:id="passwordTextField" managed="false" promptText="Nhập mật khẩu mới" visible="false" prefHeight="36.0" />
        </StackPane>
        <CheckBox fx:id="showPasswordCheckBox" onAction="#togglePasswordVisibility"
                  style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Hiện mật khẩu" />
    </VBox>

    <!-- Xác nhận mật khẩu -->
    <VBox spacing="6.0" alignment="TOP_LEFT">
        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;"
               text="Xác nhận mật khẩu" />
        <StackPane>
            <PasswordField fx:id="confirmPasswordField" promptText="Xác nhận mật khẩu" prefHeight="36.0" />
            <TextField fx:id="confirmPasswordTextField" managed="false" promptText="Xác nhận mật khẩu" visible="false" prefHeight="36.0" />
        </StackPane>
        <CheckBox fx:id="showConfirmPasswordCheckBox" onAction="#toggleConfirmPasswordVisibility"
                  style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Hiện mật khẩu" />
    </VBox>

    <!-- Nút Xác nhận xanh lá chuẩn PDF -->
    <VBox alignment="CENTER">
        <padding><Insets top="6.0" /></padding>
        <Button onAction="#handleReset"
                prefHeight="36.0" prefWidth="140.0"
                styleClass="btn-primary"
                text="Xác nhận" />
    </VBox>

</VBox>
