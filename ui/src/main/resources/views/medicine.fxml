<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="true" spacing="14"
      styleClass="card-pane"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.MedicineController">

    <!-- Thanh tiêu đề & Công cụ tìm kiếm thuốc chuẩn PDF -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label styleClass="screen-title" text="Danh mục thuốc" />
            <Label fx:id="lblTotalMedicines" styleClass="screen-subtitle" text="Tổng số loại thuốc (0)" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Ô tìm kiếm và lọc trạng thái thuốc -->
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pill-search-container" prefWidth="280">
            <ImageView fitHeight="16" fitWidth="16" opacity="0.6" preserveRatio="true">
                <image><Image url="@/assets/loupe.png" /></image>
            </ImageView>
            <TextField fx:id="tfSearch" promptText="Tìm theo mã hoặc tên thuốc..." styleClass="pill-search-field" HBox.hgrow="ALWAYS" />
        </HBox>

        <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Trạng thái:" />
        <ComboBox fx:id="cbStatusFilter" prefWidth="150.0" />
        <Button fx:id="btnAdd" onAction="#handleAddMedicine"
                styleClass="btn-primary" text="➕ Thêm thuốc" />
    </HBox>

    <!-- Bảng danh sách thuốc TableView chuẩn Mint Green -->
    <TableView fx:id="tvMedicine" editable="false" minHeight="240" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" prefWidth="120" text="Mã thuốc" />
            <TableColumn fx:id="nameCol" prefWidth="200" text="Tên thuốc" />
            <TableColumn fx:id="unitCol" prefWidth="90" text="Đơn vị" />
            <TableColumn fx:id="costCol" prefWidth="100" text="Đơn giá" />
            <TableColumn fx:id="quantityCol" prefWidth="110" text="Số lượng tồn" />
            <TableColumn fx:id="useCol" prefWidth="250" text="Công dụng" />
            <TableColumn fx:id="statusCol" prefWidth="130" text="Trạng thái" />
        </columns>
        <placeholder>
            <Label style="-fx-text-fill: #94A3B8;" text="Không có thuốc nào trong danh mục" />
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="btnEdit" onAction="#handleEditMedicine"
                styleClass="btn-blue" text="✎ Sửa" />
        <Button fx:id="btnViewDetails" onAction="#handleViewDetails"
                styleClass="btn-secondary" text="◉ Xem chi tiết" />
        <Button fx:id="btnStop" onAction="#handleStopMedicine"
                style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14;"
                text="⊖ Ngưng sử dụng" />
    </HBox>

</VBox>
