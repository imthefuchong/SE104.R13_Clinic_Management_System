<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="true" spacing="16"
      style="-fx-background-color: transparent;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.ExamHistoryController">

    <!-- CARD CHÍNH CHUẨN MOCKUP TRANG 24 PDF -->
    <VBox fillWidth="true" spacing="16" styleClass="card-pane" VBox.vgrow="ALWAYS">

        <!-- Tiêu đề màn hình chuẩn Trang 24 PDF -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1B4D3E;"
                   text="TRA CỨU LỊCH SỬ KHÁM" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- Nút Xem phiếu khám nổi bật bên phải chuẩn Mockup Trang 24 -->
            <Button fx:id="btnViewReport" onAction="#handleViewReport"
                    style="-fx-background-color: #C8E6C9; -fx-border-color: #81C784; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1B5E20; -fx-font-weight: bold; -fx-padding: 8 18; -fx-cursor: hand; -fx-font-size: 13.5px;"
                    text="📄  Xem phiếu khám" />
        </HBox>

        <!-- Bộ lọc: nhãn nằm phía trên ô nhập để không che chữ -->
        <GridPane hgap="12" vgap="6"
                  style="-fx-background-color: #FFFFFF;">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="19" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="19" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="22" />
            </columnConstraints>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Họ tên" />
                <TextField fx:id="tfHoTen" prefHeight="36" maxWidth="Infinity"
                           promptText="Nhập họ tên..."
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #CBD5E1; -fx-border-width: 1;" />
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Ngày khám" />
                <DatePicker fx:id="dpNgayKham" prefHeight="36" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Loại bệnh" />
                <ComboBox fx:id="cbLoaiBenh" prefHeight="36" maxWidth="Infinity" promptText="Tất cả"
                          style="-fx-background-radius: 6; -fx-border-radius: 6;" />
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px; -fx-text-fill: #475569;" text="Triệu chứng" />
                <TextField fx:id="tfTrieuChung" prefHeight="36" maxWidth="Infinity"
                           promptText="Nhập triệu chứng..."
                           style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #CBD5E1; -fx-border-width: 1;" />
            </VBox>

            <HBox alignment="BOTTOM_RIGHT" spacing="8"
                  GridPane.columnIndex="4" GridPane.rowIndex="0">
                <Button onAction="#handleSearch" prefHeight="36"
                        style="-fx-background-color: #3B82F6; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand;"
                        text="🔍  Tra cứu" />
                <Button onAction="#handleReset" prefHeight="36"
                        style="-fx-background-color: #FFFFFF; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 7 12; -fx-cursor: hand;"
                        text="↺  Xóa" />
            </HBox>
        </GridPane>

        <!-- BẢNG LỊCH SỬ KHÁM CHUẨN 5 CỘT TRANG 24 PDF: STT | Họ tên | Ngày khám | Loại bệnh | Triệu chứng -->
        <TableView fx:id="tvHistory" editable="false" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colSTT"        prefWidth="60.0"  text="STT" />
                <TableColumn fx:id="colHoTen"      prefWidth="220.0" text="Họ tên" />
                <TableColumn fx:id="colNgayKham"   prefWidth="130.0" text="Ngày khám" />
                <TableColumn fx:id="colLoaiBenh"   prefWidth="180.0" text="Loại bệnh" />
                <TableColumn fx:id="colTrieuChung" prefWidth="280.0" text="Triệu chứng" />
            </columns>
            <placeholder>
                <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 14px;"
                       text="Không tìm thấy lịch sử khám phù hợp" />
            </placeholder>
        </TableView>

        <!-- Dòng chân bảng: Số kết quả -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="lblCount" style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Tổng số lịch sử: 0" />
        </HBox>

    </VBox>
</VBox>
