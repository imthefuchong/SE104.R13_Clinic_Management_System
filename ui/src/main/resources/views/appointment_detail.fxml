<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="640.0" spacing="18.0"
      style="-fx-background-color: #FFFFFF; -fx-padding: 24;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.AppointmentDetailController">

    <!-- Header Tiêu đề chuẩn PDF -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
            <image><Image url="@/assets/medical-report-icon.png" /></image>
        </ImageView>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
               text="Tiếp nhận bệnh nhân" />
    </HBox>

    <!-- Form nhập liệu 2 cột chuẩn PDF -->
    <GridPane hgap="14.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <!-- Mã bệnh nhân + Nút chọn bệnh nhân cũ -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Mã bệnh nhân:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <HBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
            <TextField fx:id="txtMaBenhNhan" promptText="Nhập mã bệnh nhân..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleChonBenhNhanCu" styleClass="btn-outline-blue" text="👤 Chọn bệnh nhân đã có hồ sơ" />
        </HBox>

        <!-- Họ tên -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Họ tên:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtHoTen" promptText="Nhập họ tên đầy đủ" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Giới tính -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Giới tính:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cbGioiTinh" prefWidth="180.0" promptText="Nam" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Năm sinh -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Năm sinh:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="txtNamSinh" promptText="Nhập năm sinh (hoặc ngày/tháng/năm)" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Địa chỉ -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Địa chỉ:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="txtDiaChi" promptText="Nhập địa chỉ cư trú" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Số điện thoại -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Số điện thoại:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="txtSoDienThoai" promptText="Nhập số điện thoại liên hệ" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Ngày khám -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Ngày khám:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="txtNgayKham" editable="false" focusTraversable="false" style="-fx-background-color: #F8FAFC;" GridPane.columnIndex="1" GridPane.rowIndex="6" />

        <!-- Số thứ tự -->
        <Label style="-fx-font-size: 13.5px; -fx-text-fill: #334155;" text="Số thứ tự:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
        <TextField fx:id="txtSoThuTu" editable="false" focusTraversable="false" promptText="Được cấp khi lưu" style="-fx-background-color: #F8FAFC;" GridPane.columnIndex="1" GridPane.rowIndex="7" />
    </GridPane>

    <!-- Nút hành động ở góc dưới phải -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding><Insets top="10.0" /></padding>
        <Button onAction="#handleThemVaoDanhSach" styleClass="btn-primary" text="📝 Thêm vào danh sách" />
        <Button cancelButton="true" onAction="#handleHuy" styleClass="btn-secondary" text="✖ Hủy" />
    </HBox>

</VBox>
