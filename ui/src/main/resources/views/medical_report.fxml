<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="900.0"
            styleClass="card-pane"
            stylesheets="@../CSS/style.css"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.controllers.MedicalReportController">

    <!-- Tiêu đề trên cùng chuẩn PDF -->
    <top>
        <VBox alignment="CENTER" spacing="4">
            <padding><Insets bottom="14.0" top="4.0" /></padding>
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E3A8A;"
                   text="PHIẾU KHÁM BỆNH" BorderPane.alignment="CENTER" />
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="16.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets bottom="16.0" left="8.0" right="8.0" top="4.0" />
                    </padding>

                    <!-- 1. THÔNG TIN PHIẾU KHÁM CHUẨN PDF TRANG 26 -->
                    <TitledPane animated="false" expanded="true" text="▼ Thông tin phiếu khám">
                        <GridPane hgap="16.0" vgap="10.0">
                            <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="130.0" prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <!-- Hàng 0: Mã phiếu khám & Ngày lập -->
                            <Label text="Mã phiếu khám:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="tfMaPhieuKham" editable="false" promptText="PKB016" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Ngày lập phiếu:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <TextField fx:id="tfNgayLap" editable="false" promptText="15/07/2025" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <!-- Hàng 1: Mã bệnh nhân & Họ tên -->
                            <Label text="Mã bệnh nhân:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="tfMaBenhNhan" editable="false" promptText="BN001" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label text="Họ tên:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                            <TextField fx:id="tfHoTen" editable="false" promptText="Nguyễn Văn H" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                            <!-- Hàng 2: Ngày sinh & Giới tính -->
                            <Label text="Ngày sinh:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="tfNgaySinh" editable="false" promptText="15/05/1980" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <Label text="Giới tính:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                            <TextField fx:id="tfGioiTinh" editable="false" promptText="Nam" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                            <!-- Hàng 3: SĐT & Tên bác sĩ -->
                            <Label text="SĐT:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="tfSoDienThoai" editable="false" promptText="0978901234" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <Label text="Tên bác sĩ:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                            <TextField fx:id="tfTenBacSi" editable="false" promptText="Bác sĩ phụ trách" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                            <!-- Hàng 4: Triệu chứng -->
                            <Label text="Triệu chứng:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <TextField fx:id="tfLyDoKham" promptText="Nhập triệu chứng khám bệnh" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />

                            <!-- Hàng 5: Loại bệnh dự đoán (PDF trang 26) -->
                            <Label text="Loại bệnh dự đoán:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <ComboBox fx:id="cbLoaiBenhDuDoan" maxWidth="Infinity" promptText="--Chọn loại bệnh dự đoán--" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="5" />

                            <!-- Hàng 6: Chẩn đoán (PDF trang 26) -->
                            <Label text="Chẩn đoán:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <ComboBox fx:id="cbChanDoan" maxWidth="Infinity" promptText="--Chọn chẩn đoán--" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="6" />

                            <!-- Ẩn TextArea để giữ tương thích Controller -->
                            <TextArea fx:id="txtChanDoan" managed="false" visible="false" />
                        </GridPane>
                    </TitledPane>

                    <!-- 2. ĐƠN THUỐC -->
                    <TitledPane animated="false" expanded="true" text="▼ Đơn thuốc">
                        <VBox spacing="10.0">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
                            <HBox alignment="CENTER_RIGHT">
                                <Button fx:id="btnThemThuoc" onAction="#openMedicineSelectionDialog"
                                        styleClass="btn-primary" text="➕ Thêm thuốc vào đơn" />
                            </HBox>
                            <TableView fx:id="tableThuocHoaDon" minHeight="180.0" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colSTT" prefWidth="80.0" text="STT" />
                                    <TableColumn fx:id="colTenThuoc" prefWidth="220.0" text="Tên thuốc" />
                                    <TableColumn fx:id="colLieuDung" prefWidth="190.0" text="Liều dùng" />
                                    <TableColumn fx:id="colSoLuong" prefWidth="110.0" text="Số lượng" />
                                    <TableColumn fx:id="colGhiChu" prefWidth="140.0" text="Ghi chú" />
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #94A3B8;" text="Chưa có thuốc nào trong đơn" />
                                </placeholder>
                            </TableView>
                        </VBox>
                    </TitledPane>

                    <!-- 3. THÔNG TIN CHI PHÍ CHUẨN PDF TRANG 26 -->
                    <TitledPane animated="false" expanded="true" text="▼ Thông tin chi phí">
                        <GridPane hgap="16.0" vgap="10.0">
                            <padding><Insets bottom="14.0" left="20.0" right="20.0" top="14.0" /></padding>
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints halignment="RIGHT" minWidth="110.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Tiền khám:"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="tfTienKham" editable="false" prefWidth="150.0"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Tổng tiền:"
                                   GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <TextField fx:id="tfTongTien" editable="false" prefWidth="150.0"
                                       style="-fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-font-size: 14px;"
                                       GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <TextField fx:id="tfNgayHoaDon" managed="false" visible="false" />
                            <TextField fx:id="tfTienThuoc" managed="false" visible="false" />
                        </GridPane>
                    </TitledPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Nút hành động ở đáy màn hình -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <padding><Insets top="14.0" /></padding>
            <Button fx:id="btnLuuPhieu" styleClass="btn-primary" text="💾 Lưu phiếu" />
            <Button fx:id="btnInPhieu" styleClass="btn-secondary" text="🖨 In phiếu" />
            <Button fx:id="btnXuatPdf" managed="false" styleClass="btn-secondary"
                    text="📄 Xuất PDF" visible="false" />
        </HBox>
    </bottom>

</BorderPane>
