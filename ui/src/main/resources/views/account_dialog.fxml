<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="14.0"
      style="-fx-background-color: white; -fx-padding: 22;"
      stylesheets="@../CSS/style.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.controllers.AccountDialogController">
    <Label fx:id="lblTitle"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"
           text="Tạo tài khoản" />

    <VBox spacing="5.0">
        <Label fx:id="lblEmployee" text="Nhân viên" />
        <HBox fx:id="employeeRow">
            <ComboBox fx:id="cbEmployee" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                      promptText="Chọn nhân viên" />
            <TextField fx:id="tfEmployee" editable="false" managed="false"
                       visible="false" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>

    <VBox spacing="5.0">
        <Label text="Tên đăng nhập" />
        <TextField fx:id="tfUsername" promptText="Nhập tên đăng nhập" />
    </VBox>

    <VBox fx:id="passwordRow" spacing="5.0">
        <Label text="Mật khẩu mới" />
        <PasswordField fx:id="pfPassword" promptText="Nhập mật khẩu mới" />
    </VBox>

    <VBox fx:id="confirmPasswordRow" spacing="5.0" managed="false" visible="false">
        <Label text="Nhập lại mật khẩu mới" />
        <PasswordField fx:id="pfConfirmPassword" promptText="Nhập lại mật khẩu mới" />
    </VBox>

    <VBox fx:id="roleRow" spacing="5.0">
        <Label text="Vai trò" />
        <ComboBox fx:id="cbRole" maxWidth="Infinity" promptText="Chọn vai trò" />
    </VBox>

    <VBox fx:id="statusRow" spacing="5.0">
        <Label text="Trạng thái" />
        <ComboBox fx:id="cbStatus" maxWidth="Infinity" />
    </VBox>

    <Label fx:id="lblPasswordNote"
           style="-fx-text-fill: #2563EB; -fx-font-size: 12px; -fx-font-style: italic;"
           text="Mật khẩu có ít nhất 8 ký tự" />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <padding><Insets top="4.0" /></padding>
        <Button fx:id="btnSave" onAction="#handleSave" styleClass="btn-primary"
                text="Tạo tài khoản" />
        <Button fx:id="btnCancel" onAction="#handleCancel" styleClass="btn-secondary"
                text="Hủy" />
    </HBox>
</VBox>
